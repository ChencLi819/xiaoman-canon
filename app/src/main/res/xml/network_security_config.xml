<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 相机走明文 TCP（PTP/IP 15740），与 HTTP 明文开关无关，这里只是避免系统告警 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
